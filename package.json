{
    "name": "foxy-pdf",
    "version": "1.3.0",
    "productName": "FoxyPDF",
    "description": "Lightweight PDF reader with annotations and page organizer (by KinanDev, based on Sagar Gurtu's Lector)",
    "main": "src/js/main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "postinstall": "electron-builder install-app-deps"
    },
    "author": "KinanDev",
    "contributors": [
        "Sagar Gurtu (original Lector author, v1.1.0, MIT)"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/KinanCodeaz/lector.git"
    },
    "dependencies": {
        "pdf-lib": "^1.17.1"
    },
    "devDependencies": {
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.kinandev.foxypdf",
        "productName": "FoxyPDF",
        "copyright": "Copyright (c) 2026 KinanDev (based on Lector by Sagar Gurtu, MIT)",
        "buildVersion": "1.3.0",
        "electronLanguages": [
            "en-US"
        ],
        "files": [
            "**/*",
            "!dist/**/*",
            "!build/**/*",
            "!.git/**/*",
            "!node_modules/pdf-lib/dist/**/*",
            "!node_modules/pdf-lib/es/**/*",
            "!node_modules/pdf-lib/src/**/*",
            "!node_modules/pdf-lib/ts3.4/**/*",
            "!*.md",
            "!*.tmp.*",
            "!tmp-*.*"
        ],
        "win": {
            "target": "NSIS",
            "icon": "./src/assets/icons/win/icon.ico",
            "fileAssociations": {
                "ext": "pdf",
                "icon": "./src/assets/icons/win/file.ico"
            }
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "runAfterFinish": true,
            "shortcutName": "FoxyPDF",
            "include": "installer.nsh"
        }
    },
    "keywords": [
        "electron",
        "pdf",
        "reader"
    ]
}